# Configuration for the Vivado container. ./install.sh copies this to .env (never commit .env).
# Used by compose.yaml and by install.sh, start.sh, stop.sh and shell.sh.
# Variables already set in your shell override the values here.

# --- Set per machine by ./install.sh ---------------------------------------
# VNC password for the browser desktop, 6-8 characters (VNC only uses the first 8).
VNC_PASSWORD=CHANGE_ME
# Fixed container MAC address. The Vivado license is node-locked to it: use it without colons
# as the host ID when generating your license. Don't change it after generating the license.
CONTAINER_MAC=
# UID/GID of the container user. On Linux, install.sh sets these to yours so files in the
# mounted folders are owned by you. Docker Desktop on macOS/Windows doesn't need this.
HOST_UID=1000
HOST_GID=1000
# 1 on Linux with SELinux enforcing (Fedora, RHEL, ...): relabels the mounted folders so the
# container may use them. install.sh detects this.
SELINUX_RELABEL=

# --- Resources --------------------------------------------------------------
# How much the container may use. Empty = no extra limit: it can use everything Docker has.
# (How much Docker itself gets is set in Docker Desktop / WSL, see ./doctor.sh and README.md.)
# Memory, e.g. 12g. Vivado needs ~8g for small designs; more for bigger ones.
CONTAINER_MEMORY=
# CPU cores, e.g. 6
CONTAINER_CPUS=
# Shared memory for the desktop and Vivado's GUI
SHM_SIZE=2g
# Threads Vivado uses per job (1-32). Empty = Vivado's default (8 on Linux).
VIVADO_MAX_THREADS=

# --- Vivado -----------------------------------------------------------------
VIVADO_VERSION=2026.1
# Device families to install (comma-separated, as named in the installer's module list)
VIVADO_DEVICES=Artix-7,Zynq-7000,Spartan-7
# Rosetta crash workaround (LD_PRELOAD): auto = only when running under Rosetta, 1 = always, 0 = never
VIVADO_ROSETTA_WORKAROUND=auto

# --- Folders on the host (relative to this folder, or absolute) -------------
# WORK_DIR: your projects. Tip: clone this repo into your projects folder and set WORK_DIR=..
WORK_DIR=./work
XILINX_DIR=./xilinx
INSTALLER_DIR=./installer
LICENSE_DIR=./license

# --- Desktop / network ------------------------------------------------------
NOVNC_PORT=6080
# 127.0.0.1 = only this computer can connect. Don't change unless you know why.
BIND_ADDRESS=127.0.0.1
VNC_GEOMETRY=1920x1080
TZ=Europe/Brussels

# "no" = install.sh doesn't offer the 'vivado' command again (add it with ./install.sh --command)
VIVADO_COMMAND=

# Docker Compose project name (container/network names are derived from it)
COMPOSE_PROJECT_NAME=vivado
